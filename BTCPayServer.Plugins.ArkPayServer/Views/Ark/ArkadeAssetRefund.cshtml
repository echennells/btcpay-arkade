@using BTCPayServer.Abstractions.Extensions
@model BTCPayServer.Plugins.ArkPayServer.Models.ArkadeAssetRefundViewModel

@{
    Layout = "_Layout";
    ViewData.SetActivePage(category: "Invoices", activePage: "Invoices", title: $"Refund Arkade asset invoice {Model.InvoiceId}");
    var stepFormat = Model.Decimals > 0 ? "0.01" : "1";
    var paidFormat = Model.Decimals > 0 ? $"N{Model.Decimals}" : "N0";
}

<div class="sticky-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="UIInvoice" asp-action="ListInvoices" asp-route-storeId="@Model.StoreId">Invoices</a></li>
            <li class="breadcrumb-item"><a asp-controller="UIInvoice" asp-action="Invoice" asp-route-invoiceId="@Model.InvoiceId">@Model.InvoiceId</a></li>
            <li class="breadcrumb-item active" aria-current="page">Refund</li>
        </ol>
    </nav>
    <h2>Refund @Model.Ticker invoice</h2>
</div>

<partial name="_StatusMessage" />

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <div class="alert alert-info">
            <strong>This invoice was paid in @Model.Ticker.</strong>
            The refund will be issued as a pull payment denominated in @Model.Ticker —
            not converted to BTC.
        </div>

        <form method="post" asp-action="ArkadeAssetRefund"
              asp-route-storeId="@Model.StoreId"
              asp-route-invoiceId="@Model.InvoiceId">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-4">
                <label class="form-label">Paid amount</label>
                <div class="form-control-plaintext">
                    @Model.PaidAmount.ToString(paidFormat) <span class="text-muted">@Model.Ticker</span>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="RefundAmount" class="form-label">Refund amount (@Model.Ticker)</label>
                <input asp-for="RefundAmount" class="form-control" type="number" step="@stepFormat" min="0" required />
                <div class="form-text">Defaults to the full paid amount. Change for a partial refund.</div>
                <span asp-validation-for="RefundAmount" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ReductionPercent" class="form-label">Reduction percentage</label>
                <div class="input-group">
                    <input asp-for="ReductionPercent" class="form-control" type="number" step="0.01" min="0" max="99.99" />
                    <span class="input-group-text">%</span>
                </div>
                <div class="form-text">Optional. Deducted from the refund amount (e.g. processing fee).</div>
                <span asp-validation-for="ReductionPercent" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2" maxlength="500"></textarea>
                <div class="form-text">Optional. Shown on the pull payment claim page.</div>
            </div>

            <input type="hidden" asp-for="Ticker" />
            <input type="hidden" asp-for="Decimals" />
            <input type="hidden" asp-for="PaidAmount" />

            <button type="submit" class="btn btn-primary">Create refund</button>
            <a asp-controller="UIInvoice" asp-action="Invoice" asp-route-invoiceId="@Model.InvoiceId" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
